  let mut todo := seeds
  let mut seen : NameSet := {}
  let mut gaps : Array Json := #[]
  let mut unknownGaps : Array String := #[]
  let mut unknownAxioms : Array String := #[]
  let mut modules : NameMap Nat := {}
  while !todo.isEmpty do
    let n := todo.back!
    todo := todo.pop
    if seen.contains n then continue
    seen := seen.insert n
    let some ci := env.find? n | throwError "Missing referenced constant {n}"
    let mod := match env.getModuleIdxFor? n with
      | some idx => env.header.moduleNames[idx]!
      | none => Name.anonymous
    modules := modules.insert mod (modules.getD mod 0 + 1)
    if ci matches .axiomInfo _ then
      unless [``propext, ``Classical.choice, ``Quot.sound, ``sorryAx].contains n do
        unknownAxioms := unknownAxioms.push n.toString
    if (ci.value? (allowOpaque := true)).any (·.hasSorry) || ci.type.hasSorry then
      gaps := gaps.push <| Json.mkObj [("name",toJson n.toString),("module",toJson mod.toString)]
      unless licensed.contains n do unknownGaps := unknownGaps.push n.toString
    todo := todo ++ ci.getUsedConstantsAsSet.toArray
  let moduleRows := modules.toList.map fun (n,count) => Json.mkObj [("module",toJson n.toString),("count",toJson count)]
  IO.FS.writeFile "_out/audit/reachable.json" <| Json.pretty <| Json.mkObj [
    ("associatedDeclarations",toJson seeds.size),("visitedConstants",toJson seen.size),
    ("directSorry",toJson gaps),("unknownDirectSorry",toJson unknownGaps),
    ("unknownAxioms",toJson unknownAxioms),("modules",toJson moduleRows)]
  unless unknownGaps.isEmpty && unknownAxioms.isEmpty do
    throwError "Full, unfiltered closure found unregistered proof input: sorry={unknownGaps}; axioms={unknownAxioms}"
  logInfo m!"Full unfiltered closure of {seeds.size} associated declarations: {seen.size} constants, {gaps.size} licensed direct sorry roots, no unknown root or axiom."
