    let refs := Informal.Data.Node.externalRefs node.toNode
    unless refs.size == names.size do
      throwError "Wrong attribute declaration count for {label}"
    for name in names do
      let some ref := refs.find? (·.canonical == name)
        | throwError "Missing attribute registration {label}: {name}"
      unless ref.present && ref.origin == .blueprintAttr do
        throwError "Wrong registration origin for {label}: {name}"
      let some info := (← getEnv).find? name
        | throwError "Missing declaration {name}"
      if (info.value? (allowOpaque := true)).any (·.hasSorry) then
        unless ref.provedStatus.hasProofGap && !ref.provedStatus.hasTypeGap do
          throwError "Incorrect sorry status for {name}"
