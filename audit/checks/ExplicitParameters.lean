        let mut binders : Array Json := #[]
        for x in xs do
          let d ← x.fvarId!.getDecl
          let explicitTyp ← ppExpr d.type
          let typ ← withOptions (fun opts => (opts.setBool `pp.explicit false).setBool `pp.universes false) (ppExpr d.type)
          let red ← whnf d.type
          let redFmt ← ppExpr red
          let prop ← isProp d.type
          let refs := d.type.getUsedConstants.filter fun k =>
