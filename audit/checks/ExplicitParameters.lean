            | some idx => env.header.moduleNames[idx]!.toString.startsWith "WPFormalization."
            | none => false
          let structs := refs.filter structures.contains
          let predicates := refs.filter fun k =>
            match env.find? k with
            | some ci => ci.type.getForallBody == mkSort .zero
            | none => false
          let unregisteredPredicates := predicates.filter fun k => !(registered.contains k)
          let unregistered := structs.filter fun k => !(registered.contains k)
          let origins := refs.map fun k =>
            let module := match env.getModuleIdxFor? k with
              | some idx => env.header.moduleNames[idx]!.toString
              | none => "<unknown>"
            Json.mkObj [("name",toJson k.toString),("module",toJson module)]
          binders := binders.push <| Json.mkObj [
            ("name",toJson d.userName.toString),("type",toJson typ.pretty),
            ("explicitType",toJson explicitTyp.pretty),
            ("projectPredicates",toJson (predicates.map Name.toString)),
            ("unregisteredProjectPredicatesForManualReview",toJson (unregisteredPredicates.map Name.toString)),
            ("reducedType",toJson redFmt.pretty),("isProp",toJson prop),
            ("projectConstants",toJson origins),
            ("structureHeads",toJson (structs.map Name.toString)),
            ("unregisteredStructuresForManualReview",toJson (unregistered.map Name.toString))]
        let conclusion ← ppExpr body
        pure <| Json.mkObj [("name",toJson n.toString),("binders",toJson binders),
          ("conclusion",toJson conclusion.pretty)]
      rows := rows.push row
    pure rows
  let mut structRows : Array Json := #[]
  for n in structures do
    let some info := env.find? n | continue
    let typ ← liftTermElabM <| ppExpr info.type
    let fields := match getStructureInfo? env n with
      | some s => s.fieldNames
      | none => #[]
    let mut fieldRows : Array Json := #[]
    for fld in fields do
      if let some proj := getProjFnForField? env n fld then
        if let some ci := env.find? proj then
          let ft ← liftTermElabM <| ppExpr ci.type
          fieldRows := fieldRows.push <| Json.mkObj [("name",toJson proj.toString),("type",toJson ft.pretty)]
    structRows := structRows.push <| Json.mkObj [("name",toJson n.toString),
      ("registered",toJson (registered.contains n)),("type",toJson typ.pretty),
      ("fields",toJson fieldRows)]
  IO.FS.writeFile "_out/audit/parameters.json" <| Json.pretty <| Json.mkObj [
    ("declarations",toJson rows),("structures",toJson structRows)]
  logInfo m!"Complete outer binder inventory: {rows.size} associated declarations, {structRows.size} authored structures."
